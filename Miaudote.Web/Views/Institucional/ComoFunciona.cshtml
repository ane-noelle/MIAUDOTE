@{
    ViewData["Title"] = "Como Funciona";
}

<section class="como-hero">
    <div class="como-texto">
       

        <h1>
            Um novo lar para eles,<br />
            <span>um novo começo para você</span>
        </h1>

        <p>
            O MIAUDOTE torna a adoção simples, segura e cheia de amor.
            Veja como é fácil encontrar o seu novo melhor amigo.
        </p>
    </div>

    <div class="como-img">
        <img
            src="/imagens/comofunciona.png"
            alt="Cães e gatos disponíveis para adoção" />
    </div>
</section>

<section class="passos">
    <article class="passo">
        <div class="numero rosa">1</div>
        <div class="icone rosa">🔍</div>

        <h3>Encontre seu pet</h3>

        <p>
            Explore os animais disponíveis e encontre aquele que combina
            com você.
        </p>
    </article>

    <article class="passo">
        <div class="numero roxo">2</div>
        <div class="icone roxo">📝</div>
dos e conte por que deseja realizar a adoção.
        </p>
    </article>

    <article class="passo">
        <div class="numero verde">3</div>
        <div class="icone verde">💬</div>

        <h3>Análise e contato</h3>

        <p>
            A equipe responsável analisa a solicitação e entra em contato
            com o interessado.
        </p>
    </article>

    <article class="passo">
        <div class="numero rosa">4</div>
        <div class="icone rosa">🏠</div>

        <h3>Adoção e amor</h3>

        <p>
            Depois da aprovação, o animal poderá seguir para o novo lar.
        </p>
    </article>
</section>

<section class="cta-final">
    <div class="cta-texto">
        <h2>Adotar é transformar vidas!</h2>

        <p>
            Você pode mudar a vida de um animal e receber um novo
            companheiro.
        </p>

        <a href="/" class="btn-rosa">
            ♡ Ver animais disponíveis
        </a>
    </div>

   <div class="como-img">
    <img src="/imagens/comofunciona.png"
         alt="Ilustração sobre o processo de adoção" />
</div>