@model Miaudote.Web.Models.SolicitacaoAdocao

@{
    ViewData["Title"] = "Solicitar Adoção";
}

<div class="container">

    <h1>Solicitação de Adoção</h1>

    <h2>@Model.Animal?.Nome</h2>

    <p>
        <strong>Espécie:</strong>
        @(Model.Animal?.Especie?.Nome ?? "Não informada")
    </p>

    <p>
        <strong>Cidade:</strong>
        @(Model.Animal?.Cidade?.Nome ?? "Não informada")
    </p>

    <hr />

    <form method="post">
        <div asp-validation-summary="All"></div>

        @Html.AntiForgeryToken()

        <input asp-for="AnimalId" type="hidden" />

        <div>
            <label asp-for="NomeCompleto"></label>
            <input asp-for="NomeCompleto" />
            <span asp-validation-for="NomeCompleto"></span>
        </div>

        <div>
            <label asp-for="Email"></label>
            <input asp-for="Email" />
            <span asp-validation-for="Email"></span>
        </div>

        <div>
            <label asp-for="Telefone"></label>
            <input asp-for="Telefone" />
            <span asp-validation-for="Telefone"></span>
        </div>

        <div>
            <label asp-for="Cidade"></label>
            <input asp-for="Cidade" />
            <span asp-validation-for="Cidade"></span>
        </div>

        <div>
            <label asp-for="Endereco"></label>
            <input asp-for="Endereco" />
            <span asp-validation-for="Endereco"></span>
        </div>

        <div>
            <label asp-for="MotivoAdocao"></label>
            <textarea asp-for="MotivoAdocao" rows="5"></textarea>
            <span asp-validation-for="MotivoAdocao"></span>
        </div>

        <button type="submit">
            Enviar Solicitação
        </button>

    </form>

</div>
