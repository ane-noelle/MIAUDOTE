@model List<Miaudote.Web.Models.SolicitacaoAdocao>

@{
    ViewData["Title"] = "Solicitações";
}

<h1>Solicitações de Adoção</h1>

@if (!Model.Any())
{
    <p>Nenhuma solicitação encontrada.</p>
}
else
{
    <table border="1" cellpadding="10">
        <thead>
            <tr>
                <th>Animal</th>
                <th>Nome</th>
                <th>Cidade</th>
                <th>Status</th>
                <th>Data</th>
                <th>Ações</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Animal?.Nome</td>
                    <td>@item.NomeCompleto</td>
                    <td>@item.Cidade</td>
                    <td>@item.Status</td>
                    <td>@item.DataSolicitacao</td>

                    <td>
                        <a asp-controller="Adocao"
                           asp-action="Aprovar"
                           asp-route-id="@item.Id">
                            Aprovar
                        </a>

                        |

                        <a asp-controller="Adocao"
                           asp-action="Recusar"
                           asp-route-id="@item.Id">
                            Recusar
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}