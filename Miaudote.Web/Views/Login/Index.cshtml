@{
    ViewData["Title"] = "Login";
}

<h1>Login do Administrador</h1>

@if (ViewBag.Erro != null)
{
    <p style="color:red;">
        @ViewBag.Erro
    </p>
}

<form method="post">

    <div>
        <label>E-mail</label>
        <input type="email"
               name="email" />
    </div>

    <br />

    <div>
        <label>Senha</label>
        <input type="password"
               name="senha" />
    </div>

    <br />

    <button type="submit">
        Entrar
    </button>

</form>