@model Miaudote.Web.Models.MensagemContato

@{
    ViewData["Title"] = "Contato";
}

<section class="contato-hero">
    <div class="contato-texto">

        <h1>
            Fale com <span>a gente!</span>
        </h1>

        <p>
            Estamos aqui para tirar dúvidas, ouvir sugestões ou ajudar
            no que for preciso. Será um prazer falar com você!
        </p>

    </div>

    <div class="contato-img">
        <img src="/imagens/contato.png"
             alt="Ilustração da página de contato" />
    </div>
</section>

<section class="contato-box">

    <div class="info-contato">

        <h3>Outrosidden="true">📧</span>

            <div>
                <p class="titulo">E-mail</p>
                <p>contato@miaudote.com.br</p>
            </div>
        </div>

        <div class="item">
            <span aria-hidden="true">📱</span>

            <div>
                <p class="titulo">Telefone / WhatsApp</p>
                <p>Canal demonstrativo do projeto</p>
            </div>
        </div>

    </div>

    <div class="form-contato">

        <h3>Envie sua mensagem</h3>

        @if (TempData["Sucesso"] != null)
        {
            <div class="mensagem-sucesso">
                @TempData["Sucesso"]
            </div>
        }

     <form method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="All"></div>

            <input type="hidden"
                   asp-for="Id" />

            <div class="linha">

                <input type="text"
                       name="Nome"
                       placeholder="Nome completo"
                       maxlength="150"
                       required />

                <input type="email"
                       name="Email"
                       placeholder="E-mail"
                       maxlength="254"
                       required />

            </div>

            <input type="text"
                   name="Assunto"
                   placeholder="Assunto"
                   maxlength="150"
                   required />

            <textarea name="Mensagem"
                      rows="5"
                      maxlength="2000"
                      placeholder="Sua mensagem"
                      required></textarea>

            <button type="submit">
                ✈ Enviar mensagem
            </button>

        </form>

    </div>

</section>

<section class="cta-contato">

    <div class="cta-texto">

        <h3>Juntos por mais amor e adoção!</h3>

        <p>
            Sua mensagem pode colaborar com o desenvolvimento
            do projeto MIAUDOTE.
        </p>

        /Animais
            ♡ Ver animais disponíveis
        </a>

    </div>

    <div class="cta-img">

        /imagens/contato.png

    </div>

</section>