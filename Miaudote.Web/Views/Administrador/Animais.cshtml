@model List<Miaudote.Web.Models.Animal>

@{
    ViewData["Title"] = "Animais";
}

<h1>Gerenciar Animais</h1>

<table border="1" cellpadding="10">
    <thead>
        <tr>
            <th>Nome</th>
            <th>Espécie</th>
            <th>Cidade</th>
            <th>Status</th>
            <th>Ações</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var animal in Model)
        {
            <tr>
                <td>@animal.Nome</td>
                <td>@animal.Especie?.Nome</td>
                <td>@animal.Cidade?.Nome</td>
                <td>@animal.Status</td>

                <td>
                    <a asp-controller="Administrador"
                       asp-action="EditarAnimal"
                       asp-route-id="@animal.Id">
                        Editar
                    </a>

                    |

                    <a asp-controller="Administrador"
                       asp-action="ExcluirAnimal"
                       asp-route-id="@animal.Id">
                        Excluir
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>